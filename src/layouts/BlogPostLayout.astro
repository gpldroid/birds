---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../utils/site";
interface Props { post: CollectionEntry<"blog">; }
const { post } = Astro.props;
const { title, description, cover, category, categorySlug, publishedAt, author, readTime } = post.data;
const formattedDate = publishedAt.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---
<BaseLayout title={title} description={description} image={cover} type="article" publishedAt={publishedAt}>
  <div class="container article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={withBase("/")}>Home</a><span aria-hidden="true">/</span>
      <a href={withBase("/blog/")}>Journal</a><span aria-hidden="true">/</span>
      <a href={withBase(`/categories/${categorySlug}/`)}>{category}</a>
    </nav>
    <header class="article-header">
      <a class="eyebrow" href={withBase(`/categories/${categorySlug}/`)}>{category}</a>
      <h1>{title}</h1><p class="article-deck">{description}</p>
      <div class="byline"><span>By {author}</span><span aria-hidden="true">·</span><time datetime={publishedAt.toISOString()}>{formattedDate}</time><span aria-hidden="true">·</span><span>{readTime} min read</span></div>
    </header>
    <img class="article-hero-image" src={cover} alt={title} fetchpriority="high" />
    <div class="article-reading-layout">
      <aside class="article-aside" aria-label="Article navigation"><span>IN THIS STORY</span><a href="#article-content">Read the article</a><a href={withBase("/blog/")}>More stories</a></aside>
      <article class="prose" id="article-content"><slot /></article>
    </div>
    <div class="article-end"><span class="eyebrow">KEEP EXPLORING</span><h2>There’s always more to discover.</h2><a class="button button-dark" href={withBase("/blog/")}>Browse all articles <span>↗</span></a></div>
  </div>
</BaseLayout>