---
import type { CollectionEntry } from "astro:content";
interface Props { article: CollectionEntry<"blog">; featured?: boolean; }
const { article, featured = false } = Astro.props;
const { title, description, category, categorySlug, cover, publishedAt, readTime } = article.data;
const date = publishedAt.toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" });
---
<article class:list={["article-card", "searchable-item", { "article-card-featured": featured }]} data-search={`${title} ${description} ${category} ${article.data.tags.join(" ")}`.toLowerCase()}>
  <a class="article-image-link" href={`/articles/${article.id.replace(/\.md$/, "")}/`} aria-label={`Read ${title}`}>
    <img class="article-image" src={cover} alt={title} loading="lazy" />
    <span class="image-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="article-card-body">
    <div class="article-meta"><a href={`/categories/${categorySlug}/`} class="category-label">{category}</a><span>{readTime} min read</span></div>
    <h3><a href={`/articles/${article.id.replace(/\.md$/, "")}/`}>{title}</a></h3>
    <p>{description}</p>
    <time datetime={publishedAt.toISOString()}>{date}</time>
  </div>
</article>