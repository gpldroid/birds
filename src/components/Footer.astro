---
import { withBase } from "../utils/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand brand-light" href={withBase("/")}><span class="brand-mark">A</span><span>AVIAN WORLD<span class="brand-period">.</span></span></a>
      <p>An independent bird encyclopedia and journal for curious minds, careful observers and everyone who loves the natural world.</p>
    </div>
    <div class="footer-links"><span class="footer-heading">Explore</span><a href={withBase("/")}>Home</a><a href={withBase("/blog/")}>All articles</a><a href={withBase("/about/")}>About the project</a></div>
    <div class="footer-links"><span class="footer-heading">Discover</span><a href={withBase("/categories/raptors/")}>Birds of prey</a><a href={withBase("/categories/bird-species/")}>Bird species</a><a href="https://www.iucnredlist.org/" target="_blank" rel="noreferrer">Conservation resources ↗</a></div>
  </div>
  <div class="container footer-bottom"><span>© {year} Avian World. All rights reserved.</span><a href="#top">Back to top ↑</a></div>
</footer>