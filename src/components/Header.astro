---
import { withBase } from "../utils/site";
const navigation = [{ href: "/", label: "Home" }, { href: "/blog/", label: "Journal" }, { href: "/about/", label: "About" }];
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")} aria-label="Avian World home"><span class="brand-mark" aria-hidden="true">A</span><span>AVIAN WORLD<span class="brand-period">.</span></span></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span></button>
    <nav class="main-nav" id="primary-nav" aria-label="Primary navigation">
      {navigation.map((item) => <a class:list={["nav-link", { active: currentPath === item.href }]} href={withBase(item.href)}>{item.label}</a>)}
      <a class="nav-cta" href={withBase("/blog/")}>Explore the journal <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#primary-nav");
  menuToggle?.addEventListener("click", () => {
    const expanded = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!expanded));
    nav?.classList.toggle("is-open", !expanded);
  });
</script>