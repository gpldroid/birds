---
interface Props { placeholder?: string; label?: string; resultSuffix?: string; }
const { placeholder = "Search birds and articles...", label = "Search", resultSuffix = "result(s)" } = Astro.props;
---
<div class="search-filter" role="search">
  <label class="sr-only" for="site-search">{label}</label>
  <span aria-hidden="true">⌕</span>
  <input id="site-search" type="search" placeholder={placeholder} autocomplete="off" />
  <button type="button" id="clear-search" aria-label="Clear search">×</button>
  <p class="search-count" id="search-count" aria-live="polite" data-result-suffix={resultSuffix}></p>
</div>
<script>
  const input = document.querySelector<HTMLInputElement>("#site-search");
  const clear = document.querySelector<HTMLButtonElement>("#clear-search");
  const count = document.querySelector<HTMLElement>("#search-count");
  const items = [...document.querySelectorAll<HTMLElement>(".searchable-item")];
  const filter = () => {
    const query = input?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;
    for (const item of items) {
      const match = !query || (item.dataset.search ?? item.textContent ?? "").toLocaleLowerCase().includes(query);
      item.hidden = !match;
      if (match) visible++;
    }
    if (count) count.textContent = query ? `${visible} ${count.dataset.resultSuffix ?? "result(s)"}` : "";
    if (clear) clear.hidden = !query;
  };
  input?.addEventListener("input", filter);
  clear?.addEventListener("click", () => { if (input) { input.value = ""; filter(); input.focus(); } });
  filter();
</script>