---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { withBase } from "../utils/site";
const posts = (await getCollection("blog")).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const featured = posts.find((post)=>post.data.featured) ?? posts[0];
const latest = posts.filter((post)=>post.id !== featured?.id).slice(0,3);
const species = posts.filter((post)=>post.data.categorySlug === "bird-species").slice(0,2);
---
<BaseLayout title="Discover the world of birds" description="Avian World is an English-language bird encyclopedia and journal exploring bird species, habitats, behaviour and conservation.">
  <section class="hero-section"><div class="container hero-grid">
    <div class="hero-copy"><span class="eyebrow"><span class="eyebrow-dot"></span> THE BIRD ENCYCLOPEDIA & JOURNAL</span>
      <h1>Discover the world of <em>birds.</em></h1>
      <p>Explore remarkable species, understand the habitats they depend on, and read thoughtful stories from across the avian world.</p>
      <a class="button button-dark" href={withBase("/blog/")}>Explore the journal <span>↗</span></a>
      <div class="hero-note"><span class="hero-note-line"></span><span>OBSERVE MORE. WONDER ALWAYS.</span></div>
    </div>
    <div class="hero-visual"><img src="https://images.unsplash.com/photo-1474511320723-9a56873867b5?auto=format&fit=crop&w=1100&q=85" alt="A wild bird in its natural habitat" fetchpriority="high" />
      <div class="hero-image-caption"><span>FIELD NOTES</span><span>THE BEAUTY OF THE EVERYDAY</span></div><div class="hero-stamp" aria-hidden="true">WILD<br />BY<br />NATURE</div>
    </div>
  </div></section>
  {featured && <section class="container featured-section"><div class="section-heading"><div><span class="eyebrow">EDITOR’S PICK</span><h2>Worth a closer look<span class="brand-period">.</span></h2></div><a class="text-link" href={withBase("/blog/")}>All stories <span>↗</span></a></div>
    <div class="featured-grid"><div class="featured-photo"><img src={featured.data.cover} alt={featured.data.title} loading="lazy" /></div>
      <div class="featured-copy"><span class="eyebrow">{featured.data.category} · {featured.data.readTime} MIN READ</span>
        <h3><a href={withBase(`/blog/${featured.id.replace(/\.mdx?$/, "")}/`)}>{featured.data.title}</a></h3><p>{featured.data.description}</p>
        <a class="text-link" href={withBase(`/blog/${featured.id.replace(/\.mdx?$/, "")}/`)}>Read the story <span>↗</span></a>
      </div>
    </div>
  </section>}
  {species.length > 0 && <section class="container featured-section"><div class="section-heading"><div><span class="eyebrow">SPECIES SPOTLIGHT</span><h2>Birds to know<span class="brand-period">.</span></h2></div></div><div class="article-grid">{species.map((post)=><ArticleCard article={post} />)}</div></section>}
  <section class="latest-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">FRESH FROM THE NEST</span><h2>Latest stories<span class="brand-period">.</span></h2></div><a class="text-link" href={withBase("/blog/")}>View all articles <span>↗</span></a></div>
    <div class="article-grid">{latest.map((post)=><ArticleCard article={post} />)}</div>{latest.length===0&&<p class="empty-state">New stories are on their way. Check back soon.</p>}
  </div></section>
  <section class="newsletter-band"><div class="container newsletter-inner"><span class="eyebrow">A NOTE FROM THE WILD</span><h2>Look up. There’s a whole world above.</h2><p>Follow a feather, stay curious, and discover something new about birds.</p><a class="button button-light" href={withBase("/about/")}>About Avian World <span>↗</span></a></div></section>
</BaseLayout>