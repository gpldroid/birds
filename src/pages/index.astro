---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BirdCard from "../components/BirdCard.astro";
import { getCollection } from "astro:content";
const articles = (await getCollection("blog", ({data}) => data.language === "en")).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const birds = await getCollection("birds");
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles.filter((article) => article.id !== featured?.id).slice(0, 3);
const popular = birds.filter((bird) => bird.data.popular).slice(0, 3);
const categories = [...new Map(articles.map((article) => [article.data.categorySlug, article.data.category])).entries()];
---
<BaseLayout title="A world of wings and wonder" description="Explore the fascinating world of birds through species profiles, conservation facts and thoughtful journal articles.">
  <section class="hero-section"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><span class="eyebrow-dot"></span> THE BIRD ENCYCLOPEDIA & JOURNAL</span><h1>A little closer to the <em>wild.</em></h1><p>Explore bird species, discover their habitats and conservation stories, and read thoughtful articles from the world of ornithology.</p><a class="button button-dark" href="/birds/">Explore the bird directory <span>↗</span></a><div class="hero-note"><span class="hero-note-line"></span><span>OBSERVE MORE. WONDER ALWAYS.</span></div></div><div class="hero-visual"><img src="https://images.unsplash.com/photo-1474511320723-9a56873867b5?auto=format&fit=crop&w=1100&q=85" alt="Wild bird perched in its natural habitat" fetchpriority="high" /><div class="hero-image-caption"><span>01 / FIELD NOTES</span><span>THE BEAUTY OF THE EVERYDAY</span></div><div class="hero-stamp">WILD<br/>BY<br/>NATURE</div></div></div></section>
  <section class="container category-strip"><div><span class="eyebrow">FOLLOW YOUR CURIOSITY</span><h2>Explore the bird world</h2></div><div class="category-pills"><a href="/birds/">Bird directory <span>↗</span></a><a href="/articles/">Articles <span>↗</span></a>{categories.slice(0,3).map(([slug,name])=><a href={`/categories/${slug}/`}>{name}<span>↗</span></a>)}</div></section>
  <section class="container featured-section"><div class="section-heading"><div><span class="eyebrow">POPULAR SPECIES</span><h2>Birds to know<span class="brand-period">.</span></h2></div><a class="text-link" href="/birds/">Explore all species <span>↗</span></a></div><div class="bird-grid">{popular.map((bird)=><BirdCard bird={bird} />)}</div></section>
  {featured && <section class="container featured-section"><div class="section-heading"><div><span class="eyebrow">THE EDITOR’S PICK</span><h2>Worth a closer look<span class="brand-period">.</span></h2></div><a class="text-link" href="/articles/">All stories <span>↗</span></a></div><div class="featured-grid"><div class="featured-photo"><img src={featured.data.cover} alt={featured.data.title} loading="lazy" /></div><div class="featured-copy"><span class="eyebrow">{featured.data.category} · {featured.data.readTime} MIN READ</span><h3><a href={`/articles/${featured.id.replace(/\.md$/, "")}/`}>{featured.data.title}</a></h3><p>{featured.data.description}</p><a class="text-link" href={`/articles/${featured.id.replace(/\.md$/, "")}/`}>Read the story <span>↗</span></a></div></div></section>}
  <section class="latest-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">FRESH FROM THE NEST</span><h2>Latest stories<span class="brand-period">.</span></h2></div><a class="text-link" href="/articles/">View all articles <span>↗</span></a></div><div class="article-grid">{latest.map((article)=><ArticleCard article={article} />)}</div>{latest.length===0&&<p class="empty-state">New stories are on their way. Check back soon.</p>}</div></section>
  <section class="newsletter-band"><div class="container newsletter-inner"><span class="eyebrow">A NOTE FROM THE WILD</span><h2>Look up. There’s a whole world above.</h2><p>Take a moment, follow a feather, and let curiosity lead the way.</p><a class="button button-light" href="/about/">Get to know BIRDS <span>↗</span></a></div></section>
</BaseLayout>