---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
const articles = (await getCollection("blog")).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="All articles" description="Browse every BIRDS journal story, guide and field note.">
  <section class="page-intro container"><span class="eyebrow">THE JOURNAL</span><h1>Stories for the <em>bird-curious.</em></h1><p>Field notes, practical guides and fascinating facts from across the avian world.</p></section>
  <section class="container listing-section"><div class="listing-topline"><span>{articles.length} {articles.length === 1 ? "STORY" : "STORIES"}</span><span>NEWEST FIRST</span></div><div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div>{articles.length === 0 && <p class="empty-state">No articles published yet.</p>}</section>
</BaseLayout>