---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { withBase } from "../../utils/site";
export async function getStaticPaths() {
  const posts=await getCollection("blog");
  const categories=[...new Map(posts.map((post)=>[post.data.categorySlug,post.data.category])).entries()];
  return categories.map(([slug,name])=>({params:{slug},props:{name,posts:posts.filter((post)=>post.data.categorySlug===slug)}}));
}
const {name,posts}=Astro.props;
const sortedPosts=[...posts].sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<BaseLayout title={name} description={`Explore Avian World articles about ${name.toLowerCase()}.`}>
  <section class="page-intro container"><span class="eyebrow">EXPLORE A CATEGORY</span><h1>{name}<span class="brand-period">.</span></h1><p>Discover species profiles, insights and field guides from this corner of the avian world.</p></section>
  <section class="container listing-section"><div class="listing-topline"><span>{sortedPosts.length} STORIES</span><a class="text-link" href={withBase("/blog/")}>All articles ↗</a></div><div class="article-grid">{sortedPosts.map((post)=><ArticleCard article={post} />)}</div></section>
</BaseLayout>