---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BirdCard from "../../components/BirdCard.astro";
import ArticleCard from "../../components/ArticleCard.astro";
const birds = await getCollection("birds");
const articles = (await getCollection("blog", ({data}) => data.language === "ar")).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const popular = birds.filter((bird)=>bird.data.popular).slice(0,3);
const latest = articles.slice(0,3);
---
<BaseLayout title="عالم الطيور بين يديك" description="موسوعة ومجلة عربية للتعرف على الطيور وموائلها وسلوكها وطرق حمايتها.">
  <section class="hero-section" dir="rtl"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><span class="eyebrow-dot"></span> موسوعة ومجلة الطيور</span><h1>اكتشف عالماً من <em>الأجنحة.</em></h1><p>دليلك للتعرف على الطيور، وفهم سلوكها وموائلها، وقراءة مقالات تثري فضولك تجاه الطبيعة.</p><a class="button button-dark" href="/ar/birds/">استكشف موسوعة الطيور <span>↗</span></a><div class="hero-note"><span class="hero-note-line"></span><span>راقب أكثر، واكتشف دائماً</span></div></div><div class="hero-visual"><img src="https://images.unsplash.com/photo-1474511320723-9a56873867b5?auto=format&fit=crop&w=1100&q=85" alt="طائر بري في موطنه الطبيعي" fetchpriority="high" /><div class="hero-image-caption"><span>عالم الطيور</span><span>جمال الطبيعة من حولنا</span></div><div class="hero-stamp">عالم<br/>الطيور</div></div></div></section>
  <section class="container category-strip" dir="rtl"><div><span class="eyebrow">اكتشف حسب اهتمامك</span><h2>موسوعة الطيور</h2></div><div class="category-pills"><a href="/ar/birds/">جميع الطيور <span>↗</span></a><a href="/ar/birds/">الطيور الجارحة <span>↗</span></a><a href="/ar/birds/">الطيور المهاجرة <span>↗</span></a><a href="/ar/birds/">طيور الزينة <span>↗</span></a></div></section>
  <section class="container featured-section" dir="rtl"><div class="section-heading"><div><span class="eyebrow">طيور تستحق الاكتشاف</span><h2>طيور شهيرة<span class="brand-period">.</span></h2></div><a class="text-link" href="/ar/birds/">كل الأنواع <span>↗</span></a></div><div class="bird-grid">{popular.map((bird)=><BirdCard bird={bird} lang="ar" />)}</div></section>
  <section class="latest-section" dir="rtl"><div class="container"><div class="section-heading"><div><span class="eyebrow">من مجلة BIRDS</span><h2>أحدث المقالات<span class="brand-period">.</span></h2></div><a class="text-link" href="/ar/articles/">كل المقالات <span>↗</span></a></div><div class="article-grid">{latest.map((article)=><ArticleCard article={article} />)}</div></div></section>
</BaseLayout>