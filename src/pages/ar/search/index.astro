---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BirdCard from "../../../components/BirdCard.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import SearchFilter from "../../../components/SearchFilter.astro";
const birds=await getCollection("birds");
const articles=await getCollection("blog",({data})=>data.language==="ar");
---
<BaseLayout title="البحث" description="ابحث في موسوعة الطيور والمقالات العربية.">
 <section class="page-intro container" dir="rtl"><span class="eyebrow">اكتشف ما تبحث عنه</span><h1>ابحث في عالم <em>الطيور.</em></h1><p>ابحث عن أنواع الطيور وأسمائها العلمية وموائلها والمقالات والموضوعات.</p><SearchFilter placeholder="اكتب اسم طائر أو موطن أو موضوع..." label="البحث في الموقع" /></section>
 <section class="container search-results-section" dir="rtl"><h2>أنواع الطيور</h2><div class="bird-grid">{birds.map((bird)=><BirdCard bird={bird} lang="ar" />)}</div><h2 class="search-article-heading">المقالات</h2><div class="article-grid">{articles.map((article)=><ArticleCard article={article} />)}</div></section>
</BaseLayout>