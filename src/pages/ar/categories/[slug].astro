---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
export async function getStaticPaths(){
 const articles=await getCollection("blog",({data})=>data.language==="ar");
 const categories=[...new Map(articles.map((article)=>[article.data.categorySlug,article.data.category])).entries()];
 return categories.map(([slug,name])=>({params:{slug},props:{name,articles:articles.filter((article)=>article.data.categorySlug===slug)}}));
}
const {name,articles}=Astro.props;
const sorted=articles.sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<BaseLayout title={name} description={`مقالات BIRDS حول ${name}.`}>
 <section class="page-intro container" dir="rtl"><span class="eyebrow">تصفح حسب التصنيف</span><h1>{name}<span class="brand-period">.</span></h1><p>اكتشف مقالات ومعلومات مختارة من هذا القسم في عالم الطيور.</p></section>
 <section class="container listing-section" dir="rtl"><div class="listing-topline"><span>{sorted.length} مقالات</span><a class="text-link" href="/ar/articles/">كل المقالات ↗</a></div><div class="article-grid">{sorted.map((article)=><ArticleCard article={article} />)}</div></section>
</BaseLayout>