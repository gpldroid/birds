---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() {
  const birds = await getCollection("birds");
  return birds.map((bird) => ({ params: { slug: bird.id.replace(/\.md$/, "") }, props: { bird } }));
}
const { bird } = Astro.props;
const item = bird.data;
---
<BaseLayout title={item.name} description={item.summary} image={item.image}>
  <div class="container bird-detail-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/birds/">Bird directory</a><span>/</span><span>{item.name}</span></nav>
    <header class="bird-detail-heading"><span class="eyebrow">SPECIES PROFILE · {item.family}</span><h1>{item.name}</h1><p class="scientific-name">{item.scientificName}</p><p class="bird-detail-summary">{item.summary}</p></header>
    <img class="bird-detail-image" src={item.image} alt={item.name} />
    <div class="bird-facts-grid">
      <section class="bird-fact"><span class="eyebrow">NATURAL HABITAT</span><h2>Where it lives</h2><p>{item.habitat}</p></section>
      <section class="bird-fact"><span class="eyebrow">DIET</span><h2>What it eats</h2><p>{item.diet}</p></section>
      <section class="bird-fact"><span class="eyebrow">CONSERVATION</span><h2>{item.conservationStatus}</h2><p>Conservation status label recorded for this species. Check the linked assessment for the latest regional and global information.</p>{item.conservationSource && <a class="text-link" href={item.conservationSource} target="_blank" rel="noreferrer">View conservation reference ↗</a>}</section>
      <section class="bird-fact"><span class="eyebrow">CLASSIFICATION</span><h2>{item.category}</h2><p>Family: {item.family}</p></section>
    </div>
    <div class="article-end"><span class="eyebrow">KEEP EXPLORING</span><h2>Discover another species.</h2><a class="button button-dark" href="/birds/">Back to bird directory <span>↗</span></a></div>
  </div>
</BaseLayout>